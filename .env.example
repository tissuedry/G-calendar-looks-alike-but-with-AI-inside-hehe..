# Salin file ini menjadi .env untuk dijalankan di lokal:   cp .env.example .env
# (PowerShell: Copy-Item .env.example .env). Jangan pernah meng-commit file .env.
# Di Vercel, isi variabel yang sama lewat Project Settings -> Environment Variables.

# ---- AI ----
# Penyedia utama: groq atau gemini. Pengguna bisa mengganti lewat tombol di panel Asisten.
# Jika penyedia terpilih kena limit / gagal, server otomatis mencoba penyedia lain yang key-nya terisi.
AI_PROVIDER=groq

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# https://aistudio.google.com/apikey  (opsional, dipakai sebagai cadangan atau pilihan kedua)
GEMINI_API_KEY=
# Tiap model punya batas gratis sendiri (cek https://ai.dev/rate-limit). Model 2.5 sudah tidak tersedia untuk pengguna baru.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Database ----
# Kosongkan di lokal -> data disimpan di file .data/db.json.
# Di Vercel wajib diisi dengan connection string Supabase (Connect -> Transaction pooler, port 6543):
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Jika password mengandung karakter khusus (@ # / ? dll), ubah dulu ke bentuk URL-encoded.
DATABASE_URL=

# ---- Login ----
# Wajib diisi saat deploy agar kalender & kuota AI Anda tidak dipakai orang lain.
# Kosongkan di lokal kalau tidak perlu login.
APP_USERNAME=
APP_PASSWORD=
# String acak panjang untuk menandatangani cookie sesi (disarankan). Contoh: openssl rand -hex 32
AUTH_SECRET=
